# Copiar como .env (NO se sube a GitHub) y ajustar.

# ---------------------------------------------------------------- Local (Mac)
# Sin .env todo funciona con estos valores por defecto:
#   DOMINIO=bufete.internal   CADDY_TLS=internal   BUFETE_CODIGO=BUFETE-2026

# ---------------------------------------------------------------- Producción (AWS)
# Dominio que apunta a la IP del servidor (por ejemplo, de DuckDNS)
DOMINIO=mi-bufete.duckdns.org

# Correo para Let's Encrypt (con esto Caddy obtiene un certificado real)
CADDY_TLS=tu-correo@ejemplo.com

# Código que necesitan los abogados para registrarse. Use uno propio, no el del repo.
BUFETE_CODIGO=cambiar-por-un-codigo-largo

# Llave AES-256 que cifra los secretos TOTP en la base de datos (64 caracteres hex).
# Generar con:  python3 -c "import secrets; print(secrets.token_hex(32))"
# Si se pierde, los usuarios deberán volver a configurar su autenticador.
TOTP_LLAVE=
